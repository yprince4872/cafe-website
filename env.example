# Copy this file to .env and fill in your own values. Never commit or share the real .env file.

# ---- Database: MongoDB (for example a free MongoDB Atlas cluster) ----
# Atlas: Database -> Connect -> Drivers -> copy the connection string, put your database user's password in it.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOURCLUSTER.mongodb.net/
# Name of the database to create/use inside your cluster (you can keep this)
MONGODB_DB=musafir_cafe

# Port the API listens on (hosting services set this by themselves)
PORT=4000

# Set to production on your live server. Then ONLY the addresses below can use the API.
NODE_ENV=production

# Your live website address(es), comma separated, WITHOUT a trailing slash.
# While testing on your own computer/phone, local addresses are allowed automatically.
ALLOWED_ORIGINS=https://your-website.com,https://www.your-website.com

# Secret key for the admin panel (make it long and random)
ADMIN_API_KEY=change-this-to-a-long-random-string

# ---- Email notifications (sent to the cafe when an order / booking comes in) ----
# Gmail: turn on 2-Step Verification, then create an "App Password" and use it as SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
NOTIFY_TO=yprince4872@gmail.com
NOTIFY_FROM="Musafir Cafe Website" <your-email@gmail.com>

# ---- UPI payments (GPay, PhonePe, Paytm...) ----
# You can set your UPI ID in the admin panel (Site Content tab). These two lines are an
# optional fallback, used only when nothing is saved in the admin panel.
UPI_ID=
UPI_NAME=Musafir Cafe
