# Copy this file to .env and fill in your own values. Never commit the real .env file.

# Port the API listens on
PORT=4000

# Comma-separated list of origins allowed to call this API (your frontend URLs)
ALLOWED_ORIGINS=http://localhost:5500,https://your-frontend-domain.com

# Secret key required in the "x-admin-key" header to view/manage reservations
ADMIN_API_KEY=change-this-to-a-long-random-string 

# ---- Email notifications (sent to the cafe when a reservation comes in) ----
# Works with Gmail (use an App Password, not your normal password),
# or any SMTP provider (SendGrid, Mailgun, Zoho, your host's SMTP, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Where reservation notifications should be sent
NOTIFY_TO=yprince4872@gmail.com
NOTIFY_FROM="Musafir Cafe Website" <your-email@gmail.com>

# ---- UPI payments (GPay, PhonePe, Paytm...) ----
# You can set your UPI ID in the admin panel (Site Content tab). These two lines are an
# optional fallback, used only when nothing is saved in the admin panel.
UPI_ID=
UPI_NAME=Musafir Cafe
